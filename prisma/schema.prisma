// Prisma Schema for A-Stock Data Platform (SQLite)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

/// 股票日K线数据
model StockDaily {
  id          BigInt   @id @default(autoincrement())
  code        String
  name        String?
  tradeDate   DateTime @map("trade_date")
  
  open        Float?
  high        Float?
  low         Float?
  close       Float?
  preClose    Float?   @map("pre_close")
  change      Float?
  pctChange   Float?   @map("pct_change")
  volume      BigInt?
  amount      Float?
  turnover    Float?
  
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([code, tradeDate])
  @@index([code])
  @@index([tradeDate])
  @@map("stock_daily")
}

/// 龙虎榜数据
model DragonTigerList {
  id          BigInt   @id @default(autoincrement())
  tradeDate   DateTime @map("trade_date")
  code        String
  name        String?
  
  close       Float?
  pctChange   Float?   @map("pct_change")
  turnover    Float?
  amount      Float?
  netBuy      Float?   @map("net_buy")
  buyAmount   Float?   @map("buy_amount")
  sellAmount  Float?   @map("sell_amount")
  
  reason      String?
  
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([tradeDate, code, reason])
  @@index([tradeDate])
  @@index([code])
  @@map("dragon_tiger_list")
}

/// 龙虎榜营业部明细
model DragonTigerDetail {
  id          BigInt   @id @default(autoincrement())
  tradeDate   DateTime @map("trade_date")
  code        String
  name        String?
  
  rank        Int?
  trader      String?
  
  buyAmount   Float?   @map("buy_amount")
  sellAmount  Float?   @map("sell_amount")
  netAmount   Float?   @map("net_amount")
  
  direction   String?
  
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([tradeDate, code])
  @@map("dragon_tiger_detail")
}

/// 数据采集日志
model CollectionLog {
  id              BigInt   @id @default(autoincrement())
  collectionDate  DateTime @map("collection_date")
  dataType        String   @map("data_type")
  status          String
  count           Int      @default(0)
  message         String?
  
  startedAt       DateTime? @map("started_at")
  finishedAt      DateTime? @map("finished_at")

  @@index([collectionDate, dataType])
  @@map("collection_log")
}
