// Prisma Schema for A-Stock Data Platform

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

/// 股票日K线数据
model StockDaily {
  id          BigInt   @id @default(autoincrement())
  code        String   @db.VarChar(10)
  name        String?  @db.VarChar(50)
  tradeDate   DateTime @map("trade_date") @db.Date
  
  open        Decimal? @db.Decimal(12, 4)
  high        Decimal? @db.Decimal(12, 4)
  low         Decimal? @db.Decimal(12, 4)
  close       Decimal? @db.Decimal(12, 4)
  preClose    Decimal? @map("pre_close") @db.Decimal(12, 4)
  change      Decimal? @db.Decimal(12, 4)
  pctChange   Decimal? @map("pct_change") @db.Decimal(10, 4)
  volume      BigInt?
  amount      Decimal? @db.Decimal(20, 4)
  turnover    Decimal? @db.Decimal(10, 6)
  
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([code, tradeDate])
  @@index([code])
  @@index([tradeDate])
  @@map("stock_daily")
}

/// 龙虎榜数据
model DragonTigerList {
  id          BigInt   @id @default(autoincrement())
  tradeDate   DateTime @map("trade_date") @db.Date
  code        String   @db.VarChar(10)
  name        String?  @db.VarChar(50)
  
  close       Decimal? @db.Decimal(12, 4)
  pctChange   Decimal? @map("pct_change") @db.Decimal(10, 4)
  turnover    Decimal? @db.Decimal(10, 6)
  amount      Decimal? @db.Decimal(20, 4)
  netBuy      Decimal? @map("net_buy") @db.Decimal(20, 4)
  buyAmount   Decimal? @map("buy_amount") @db.Decimal(20, 4)
  sellAmount  Decimal? @map("sell_amount") @db.Decimal(20, 4)
  
  reason      String?  @db.VarChar(200)
  
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([tradeDate, code, reason])
  @@index([tradeDate])
  @@index([code])
  @@map("dragon_tiger_list")
}

/// 龙虎榜营业部明细
model DragonTigerDetail {
  id          BigInt   @id @default(autoincrement())
  tradeDate   DateTime @map("trade_date") @db.Date
  code        String   @db.VarChar(10)
  name        String?  @db.VarChar(50)
  
  rank        Int?
  trader      String?  @db.VarChar(200)
  
  buyAmount   Decimal? @map("buy_amount") @db.Decimal(20, 4)
  sellAmount  Decimal? @map("sell_amount") @db.Decimal(20, 4)
  netAmount   Decimal? @map("net_amount") @db.Decimal(20, 4)
  
  direction   String?  @db.VarChar(10)
  
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([tradeDate, code])
  @@map("dragon_tiger_detail")
}

/// 数据采集日志
model CollectionLog {
  id              BigInt   @id @default(autoincrement())
  collectionDate  DateTime @map("collection_date") @db.Date
  dataType        String   @map("data_type") @db.VarChar(50)
  status          String   @db.VarChar(20)
  count           Int      @default(0)
  message         String?  @db.VarChar(500)
  
  startedAt       DateTime? @map("started_at")
  finishedAt      DateTime? @map("finished_at")

  @@index([collectionDate, dataType])
  @@map("collection_log")
}
